# Lisp sources must stay LF on every platform: SBCL's FORMATTER rejects
# multi-line format strings whose continuation lines end in CR (CRLF
# checkouts break `~` followed by a Return character).
*.lisp text eol=lf
*.asd text eol=lf
*.ros text eol=lf

# Scripts
*.sh text eol=lf

# Keep Windows scripts as-is
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
