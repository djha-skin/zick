#!/bin/sh
# Black-box test: `zick verify` exits 0 when a package's files are
# correct, 3 when the package is not installed, and 4 when a file has
# been tampered with.  Run from the project root (see test-all).
set -eu

root_path=${PWD}
runthis=${ZICK_BIN:-${root_path}/com.djhaskin.zick}
fixture_url=${FIXTURE_URL:-https://127.0.0.1:8443}
test_home=${root_path}/tests/resources/data/verify

rm -rf "${test_home}"
mkdir -p "${test_home}/proj"

"${runthis}" init -d "${test_home}/proj" > /dev/null 2>&1
"${runthis}" add -d "${test_home}/proj" \
    -k a -V 0.1.0 -l "${fixture_url}/a.zip" -n > /dev/null 2>&1

# Correct files: exit 0.
"${runthis}" verify -d "${test_home}/proj" -k a \
    > "${test_home}/ok.nrdl" 2>&1
grep -q 'result package-found' "${test_home}/ok.nrdl"
grep -Fq 'verification-results [' "${test_home}/ok.nrdl"

# All packages: exit 0 when the whole project is correct.
"${runthis}" verify --all -d "${test_home}/proj" \
    > "${test_home}/all-ok.nrdl" 2>&1
grep -q 'result packages-found' "${test_home}/all-ok.nrdl"

# Not installed: exit 3.
set +e
"${runthis}" verify -d "${test_home}/proj" -k ghost \
    > "${test_home}/ghost.nrdl" 2>&1
ghost_exit=$?
set -e
[ "${ghost_exit}" -eq 3 ]

# Tampered file: exit 4.
echo 'tampered' > "${test_home}/proj/a/poem.txt"
set +e
"${runthis}" verify -d "${test_home}/proj" -k a \
    > "${test_home}/tampered.nrdl" 2>&1
tampered_exit=$?
set -e
[ "${tampered_exit}" -eq 4 ]
grep -q 'verification-failed' "${test_home}/tampered.nrdl"

# --all also returns 4 and reports the tampered package.
set +e
"${runthis}" verify --all -d "${test_home}/proj" \
    > "${test_home}/all-tampered.nrdl" 2>&1
all_tampered_exit=$?
set -e
[ "${all_tampered_exit}" -eq 4 ]
grep -q 'package "a"' "${test_home}/all-tampered.nrdl"
echo "test-verify: ok"
