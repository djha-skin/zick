#!/bin/sh
# Black-box test: `zick files` lists the files owned by a package with
# their classes, checksums, and sizes; a package that was never
# installed reports not-found.
# Run from the project root (see test-all).
set -eu

root_path=${PWD}
runthis=${ZICK_BIN:-${root_path}/com.djhaskin.zick}
fixture_url=${FIXTURE_URL:-https://127.0.0.1:8443}
test_home=${root_path}/tests/resources/data/files

rm -rf "${test_home}"
mkdir -p "${test_home}/proj"

"${runthis}" init -d "${test_home}/proj" > /dev/null 2>&1
"${runthis}" add -d "${test_home}/proj" \
    -k a -V 0.1.0 -l "${fixture_url}/a.zip" -n > /dev/null 2>&1

"${runthis}" files -d "${test_home}/proj" -k a \
    > "${test_home}/files.nrdl" 2>&1
grep -q 'result package-found' "${test_home}/files.nrdl"
grep -q 'path "a/poem.txt"' "${test_home}/files.nrdl"
grep -q 'class normal-file' "${test_home}/files.nrdl"
grep -q 'path "a/willows.txt"' "${test_home}/files.nrdl"

"${runthis}" files -d "${test_home}/proj" -k ghost \
    > "${test_home}/ghost.nrdl" 2>&1
grep -q 'result not-found' "${test_home}/ghost.nrdl"
echo "test-files: ok"
