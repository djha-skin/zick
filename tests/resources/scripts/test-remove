#!/bin/sh
# Black-box test: `zick remove` removes a package and its files,
# refuses to remove a package other packages depend on, and removes
# dependents with --cascade.  Run from the project root (see test-all).
set -eu

root_path=${PWD}
runthis=${ZICK_BIN:-${root_path}/com.djhaskin.zick}
fixture_url=${FIXTURE_URL:-https://127.0.0.1:8443}
test_home=${root_path}/tests/resources/data/remove

rm -rf "${test_home}"
mkdir -p "${test_home}/proj"

"${runthis}" init -d "${test_home}/proj" > /dev/null 2>&1
"${runthis}" add -d "${test_home}/proj" \
    -k a -V 0.1.0 -l "${fixture_url}/a.zip" -n > /dev/null 2>&1
"${runthis}" add -d "${test_home}/proj" \
    -k b -V 0.1.0 -l "${fixture_url}/b.zip" -n -u a > /dev/null 2>&1

# Removing a package that has dependents is refused.
set +e
"${runthis}" remove -d "${test_home}/proj" -k a \
    > "${test_home}/refused.nrdl" 2>&1
refused_exit=$?
set -e
[ "${refused_exit}" -ne 0 ]
grep -q 'cannot remove' "${test_home}/refused.nrdl" \
    || grep -q 'depend' "${test_home}/refused.nrdl"

# Cascade removes the dependent too.
"${runthis}" remove -d "${test_home}/proj" -k a -c \
    > "${test_home}/cascade.nrdl" 2>&1
grep -q 'removed-packages' "${test_home}/cascade.nrdl"
[ ! -e "${test_home}/proj/a/poem.txt" ]
[ ! -e "${test_home}/proj/b/fie.txt" ]

# Removing a package that is not installed reports not-found.
"${runthis}" remove -d "${test_home}/proj" -k ghost \
    > "${test_home}/ghost.nrdl" 2>&1
grep -q 'result not-found' "${test_home}/ghost.nrdl"
echo "test-remove: ok"
