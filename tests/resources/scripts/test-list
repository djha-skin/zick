#!/bin/sh
# Black-box test: `zick list` prints every installed package with its
# version, sorted by name; an empty database prints nothing and exits 0.
# Run from the project root (see test-all).
set -eu

root_path=${PWD}
runthis=${ZICK_BIN:-${root_path}/com.djhaskin.zick}
fixture_url=${FIXTURE_URL:-https://127.0.0.1:8443}
test_home=${root_path}/tests/resources/data/list

rm -rf "${test_home}"
mkdir -p "${test_home}/proj"

"${runthis}" init -d "${test_home}/proj" > /dev/null 2>&1

# An empty database prints nothing and exits 0.
set +e
"${runthis}" list -d "${test_home}/proj" > "${test_home}/empty.out" 2>&1
exit_code=$?
set -e
if [ "${exit_code}" -ne 0 ]; then
    echo "test-list: list on an empty database exited ${exit_code}" >&2
    exit 1
fi
if [ -s "${test_home}/empty.out" ]; then
    echo "test-list: list on an empty database printed output" >&2
    cat "${test_home}/empty.out" >&2
    exit 1
fi

# Install two packages out of name order; list must sort by name.
"${runthis}" add -d "${test_home}/proj" \
    -k b -V 0.2.0 -l "${fixture_url}/b.zip" -n > /dev/null 2>&1
"${runthis}" add -d "${test_home}/proj" \
    -k a -V 0.1.0 -l "${fixture_url}/a.zip" -n > /dev/null 2>&1
"${runthis}" list -d "${test_home}/proj" \
    > "${test_home}/list.nrdl" 2>&1

grep -q 'result successful' "${test_home}/list.nrdl"
grep -q 'name "a"' "${test_home}/list.nrdl"
grep -q 'version "0.1.0"' "${test_home}/list.nrdl"
grep -q 'name "b"' "${test_home}/list.nrdl"
grep -q 'version "0.2.0"' "${test_home}/list.nrdl"

a_pos=$(grep -n 'name "a"' "${test_home}/list.nrdl" | head -1 | cut -d: -f1)
b_pos=$(grep -n 'name "b"' "${test_home}/list.nrdl" | head -1 | cut -d: -f1)
if [ -z "${a_pos}" ] || [ -z "${b_pos}" ] || [ "${a_pos}" -ge "${b_pos}" ]; then
    echo "test-list: packages not reported in name order" >&2
    exit 1
fi

echo "test-list: ok"
